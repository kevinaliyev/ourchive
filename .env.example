# Copy this file to .env on your VPS before running `docker compose up -d --build`
OURCHIVE_APP_DOMAIN=archive.yourdomain.com
OURCHIVE_SHARE_DOMAIN=s.yourdomain.com

# Optional: once official signed Agent binaries are published (e.g. GitHub Releases),
# set this URL to switch install commands from self-hosted /downloads to signed releases.
# OURCHIVE_AGENT_DOWNLOAD_URL=https://github.com/OWNER/REPO/releases/latest/download
