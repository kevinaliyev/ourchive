<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="ourchive"
        Arguments=""
        InstallLocation="C:\Program Files\Ourchive\Ourchive">
    </Installer>
    <PackageInformation
        PackageName="Ourchive"
        PackageDisplayName="Ourchive"
        PublisherName="CN=Ourchive"
        PublisherDisplayName="Ourchive"
        Version="0.4.0.0"
        PackageDescription="Ourchive desktop client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.ourchive.client"
                Description="Ourchive desktop client"
                DisplayName="Ourchive"
                ExecutableName="ourchive"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Ourchive</DisplayName>
            <PublisherDisplayName>Ourchive</PublisherDisplayName>
            <Description>Ourchive desktop client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="ourchive.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
